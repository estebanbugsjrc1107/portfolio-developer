---
import { navigation, site } from "../../data/site";
import { getLocale, translations, type Locale } from "../../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale: requestedLocale } = Astro.props;
const locale = getLocale(requestedLocale);
const copy = translations[locale];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-brand" href={`/${locale}/`} aria-label={`${site.name} ${copy.home}`}>
      <span class="site-brand__initial">{site.brand.initial}</span>{site.brand.name}<span class="site-brand__domain">{site.brand.domain}</span>
    </a>

    <nav class="site-nav" aria-label={copy.navigationLabel}>
      {navigation.map((item, index) => (
        <a class="site-nav__link" href={item.href}>{copy.navigation[index]}</a>
      ))}
    </nav>

    <nav class="language-switch" aria-label={locale === "en" ? "Language selection" : "Selección de idioma"}>
      {locale === "en" ? (
        <span class="language-switch__active" lang="en" aria-current="page">EN</span>
      ) : (
        <a class="language-switch__link" href="/en/" lang="en">EN</a>
      )}
      <span class="language-switch__separator" aria-hidden="true">/</span>
      {locale === "es" ? (
        <span class="language-switch__active" lang="es" aria-current="page">ES</span>
      ) : (
        <a class="language-switch__link" href="/es/" lang="es">ES</a>
      )}
    </nav>

    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      data-label-light={copy.theme.light}
      data-label-dark={copy.theme.dark}
      aria-label={copy.theme.dark}
    >
      <svg class="theme-toggle__moon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <path d="M20.2 15.4A8.7 8.7 0 0 1 8.6 3.8 8.8 8.8 0 1 0 20.2 15.4Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <svg class="theme-toggle__sun" aria-hidden="true" viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</header>

<script is:inline>
  (() => {
    const storageKey = "portfolio-theme";
    const toggle = document.querySelector("[data-theme-toggle]");

    const updateButtonLabel = () => {
      const isDark = document.documentElement.dataset.theme === "dark";
      toggle?.setAttribute(
        "aria-label",
        isDark ? toggle.dataset.labelLight ?? "Switch to light theme" : toggle.dataset.labelDark ?? "Switch to dark theme",
      );
    };

    updateButtonLabel();

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      if (!event.target.closest("[data-theme-toggle]")) return;

      const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = nextTheme;
      updateButtonLabel();

      try {
        window.localStorage.setItem(storageKey, nextTheme);
      } catch {
        // Theme changes still work for this page when browser storage is blocked.
      }
    });
  })();
</script>

<style>
  .site-header {
    position: relative;
    z-index: 5;
  }

  .site-header .site-brand {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.75rem;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-left: auto;
  }

  .site-nav__link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-nav__link:hover {
    color: var(--color-text);
  }

  .language-switch {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.625rem;
  }

  .language-switch__active {
    color: var(--color-text);
  }

  .language-switch__link,
  .language-switch__separator {
    color: var(--color-muted);
  }

  .language-switch__link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .language-switch__link:hover {
    color: var(--color-text);
  }

  .theme-toggle {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: transparent;
    color: var(--color-muted);
    transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-text);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .theme-toggle svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .theme-toggle__sun,
  :global([data-theme="dark"]) .theme-toggle__moon {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__sun {
    display: block;
  }

  @media (max-width: 50rem) {
    .site-header__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      padding-block: 1.4375rem;
      gap: 0.5rem 1.25rem;
    }

    .site-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-left: 0;
      gap: clamp(0.75rem, 2vw, 1.25rem);
    }

    .language-switch {
      grid-column: 1;
      grid-row: 3;
      justify-self: start;
    }

    .theme-toggle {
      grid-column: 2;
      grid-row: 3;
    }
  }

  @media (max-width: 32rem) {
    .site-nav {
      gap: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>

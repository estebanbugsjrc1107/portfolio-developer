---
import { site, socialLinks } from "../../data/site";
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand-block">
      <a class="site-brand site-footer__brand" href="/" aria-label={`${site.name} home`}>
        <span class="site-brand__initial">{site.brand.initial}</span>{site.brand.name}<span class="site-brand__domain">{site.brand.domain}</span>
      </a>
      <small class="site-footer__credit">{site.watermark}</small>
    </div>

    <nav class="site-footer__socials" aria-label="Social media">
      {socialLinks.map((item) => (
        <a
          class="site-footer__social-link"
          href={item.href}
          target="_blank"
          rel="noreferrer"
          aria-label={`${item.label} (opens in a new tab)`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a class="site-footer__back-to-top" href="#top">
      <span>Back to top</span>
      <span class="site-footer__top-icon" aria-hidden="true">⌃</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid #3a403b;
    background: #202421;
    color: #f4f4ef;
    font-size: 0.625rem;
    padding-block: 1.625rem;
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .site-footer__brand-block {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
  }

  .site-footer__brand {
    font-size: 0.875rem;
  }

  .site-footer__credit {
    color: #717a72;
    font-size: 0.5625rem;
  }

  .site-footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.0625rem;
    margin-left: auto;
    margin-right: 1.75rem;
  }

  .site-footer__social-link,
  .site-footer__back-to-top {
    color: #8c958c;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-footer__social-link:hover,
  .site-footer__back-to-top:hover {
    color: var(--color-accent);
  }

  .site-footer__back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-footer__top-icon {
    display: grid;
    width: 1.625rem;
    height: 1.625rem;
    place-items: center;
    border: 1px solid #596259;
    border-radius: 50%;
    font-size: 0.875rem;
  }

  @media (max-width: 50rem) {
    .site-footer__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer__socials {
      margin: 0;
    }
  }
</style>

---
import { site, socialLinks } from "../../data/site";
import { getLocale, translations, type Locale } from "../../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale: requestedLocale } = Astro.props;
const locale = getLocale(requestedLocale);
const copy = translations[locale];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand-block">
      <a class="site-brand site-footer__brand" href={`/${locale}/`} aria-label={`${site.name} ${copy.home}`}>
        <span class="site-brand__initial">{site.brand.initial}</span>{site.brand.name}<span class="site-brand__domain">{site.brand.domain}</span>
      </a>
      <small class="site-footer__credit">{copy.watermark}</small>
    </div>

    <nav class="site-footer__socials" aria-label={copy.socialMedia}>
      {socialLinks.map((item) => (
        <a
          class="site-footer__social-link"
          href={item.href}
          target="_blank"
          rel="noreferrer"
          aria-label={`${item.label} (${copy.opensNewTab})`}
        >
          {item.icon === 'github' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.08 1.84 1.23 1.84 1.23 1.07 1.83 2.8 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.62-2.8 5.64-5.48 5.94.43.37.81 1.09.81 2.2v3.26c0 .32.22.69.82.57A12 12 0 0 0 12 .3Z" />
            </svg>
          )}
          {item.icon === 'linkedin' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.78C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.78 24h20.44c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0Z" />
            </svg>
          )}
          {item.icon === 'instagram' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle class="site-footer__icon-dot" cx="17.5" cy="6.5" r="0.75" />
            </svg>
          )}
          {item.icon === 'facebook' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M13.2 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H7v3.1h2.8v8h3.4Z" />
            </svg>
          )}
          {item.icon === 'tiktok' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14 3v11.1a3.4 3.4 0 1 1-3-3.37V7.3a7.5 7.5 0 1 0 7 7.47V9.2a8.4 8.4 0 0 0 3 1V6.8A5.7 5.7 0 0 1 16.2 3H14Z" />
            </svg>
          )}
          {item.icon === 'youtube' && (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 8.2a2.8 2.8 0 0 0-2-2C18.2 5.7 12 5.7 12 5.7s-6.2 0-8 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 1.5 12a29 29 0 0 0 .5 3.8 2.8 2.8 0 0 0 2 2c1.8.5 8 .5 8 .5s6.2 0 8-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-3.8 29 29 0 0 0-.5-3.8ZM10 15.1V8.9l5.2 3.1-5.2 3.1Z" />
            </svg>
          )}
        </a>
      ))}
    </nav>

    <a class="site-footer__back-to-top" href="#top">
      <span>{copy.backToTop}</span>
      <span class="site-footer__top-icon" aria-hidden="true">⌃</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid #3a403b;
    background: #202421;
    color: #f4f4ef;
    font-size: 0.625rem;
    padding-block: 1.625rem;
  }

  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .site-footer__brand-block {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
    min-width: 0;
  }

  .site-footer__credit {
    color: #929b92;
    font-size: 0.5625rem;
  }

  .site-footer__socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.125rem;
    margin-left: auto;
    margin-right: 1.75rem;
  }

  .site-footer__social-link {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: #8c958c;
    transition: color 180ms ease, transform 180ms ease;
  }

  .site-footer__social-link:hover {
    transform: translateY(-2px);
    color: var(--color-accent);
  }

  .site-footer__social-link svg {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .site-footer__social-link svg rect,
  .site-footer__social-link svg circle {
    fill: none;
  }

  .site-footer__social-link svg .site-footer__icon-dot {
    fill: currentColor;
    stroke: none;
  }

  .site-footer__back-to-top {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    color: #8c958c;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-footer__back-to-top:hover {
    color: var(--color-accent);
  }

  .site-footer__top-icon {
    display: grid;
    width: 1.625rem;
    height: 1.625rem;
    place-items: center;
    border: 1px solid #596259;
    border-radius: 50%;
    font-size: 0.875rem;
  }

  @media (max-width: 50rem) {
    .site-footer__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .site-footer__socials {
      margin: 0;
    }

    .site-footer__back-to-top {
      align-self: flex-end;
      margin-top: 0;
    }
  }
</style>

---
import { Image } from "astro:assets";
import portraitImage from "../../assets/portrait-dev.webp";
import { hero } from "../../data/site";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="hero__eyebrow">
        <span class="hero__eyebrow-line" aria-hidden="true"></span>
        {hero.eyebrow}
      </p>

      <h1 class="hero__title" id="hero-title">
        <span>{hero.title}</span>
        <em>{hero.titleAccent}</em>
      </h1>

      <p class="hero__description">{hero.description}</p>

      <div class="hero__actions">
        <a class="hero__button" href={hero.primaryLink.href}>
          {hero.primaryLink.label}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="hero__text-link" href={hero.secondaryLink.href}>
          {hero.secondaryLink.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="hero__visual">
      <figure class="hero__portrait-frame">
        <Image
          class="hero__portrait"
          src={portraitImage}
          alt={hero.portraitAlt}
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 50rem) 76vw, 365px"
          format="webp"
          loading="eager"
        />
        <figcaption class="hero__portrait-caption">
          <span>{hero.portraitCaption}</span>
          <span>{hero.portraitCopyright}</span>
        </figcaption>
      </figure>

      <p class="hero__note">
        <span aria-hidden="true">✳</span>
        <span>Building with<br /><strong>care &amp; curiosity</strong></span>
      </p>
      <div class="hero__orbit hero__orbit--primary" aria-hidden="true"></div>
      <div class="hero__orbit hero__orbit--secondary" aria-hidden="true"></div>
    </div>
  </div>

  <div class="hero-availability">
    <div class="container hero-availability__inner">
      <span class="hero-availability__status">
        <span class="hero-availability__dot" aria-hidden="true"></span>
        {hero.availability}
      </span>
      <span class="hero-availability__rule" aria-hidden="true"></span>
      <span class="hero-availability__location">{hero.location}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: clip;
    padding-top: 3.4375rem;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(25rem, 0.8fr);
    align-items: center;
    gap: 4.375rem;
    min-height: 40.625rem;
    padding-bottom: 5.125rem;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.625rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__eyebrow-line {
    width: 2rem;
    height: 1px;
    flex: 0 0 auto;
    background: var(--color-accent);
  }

  .hero__title {
    max-width: 48.75rem;
    font-size: clamp(3.125rem, 6.2vw, 5.3125rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.98;
  }

  .hero__title span,
  .hero__title em {
    display: block;
  }

  .hero__title em {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 1.03em;
    font-weight: 500;
    letter-spacing: -0.06em;
  }

  .hero__description {
    max-width: 26.25rem;
    margin-top: 1.9375rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.8125rem;
    margin-top: 2.125rem;
  }

  .hero__button,
  .hero__text-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3.125rem;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .hero__button {
    padding-inline: 1.125rem;
    background: var(--color-text);
    color: var(--color-bg);
  }

  .hero__button:hover {
    transform: translateY(-2px);
    background: var(--color-accent);
  }

  .hero__text-link {
    color: var(--color-muted);
  }

  .hero__text-link:hover {
    color: var(--color-accent);
  }

  .hero__visual {
    position: relative;
    min-height: 30.625rem;
  }

  .hero__portrait-frame {
    position: absolute;
    z-index: 2;
    top: 0;
    right: 10%;
    width: min(78%, 22.8125rem);
    height: 30rem;
    margin: 0;
    overflow: hidden;
    background: #171817;
  }

  .hero__portrait-frame::after {
    position: absolute;
    z-index: 2;
    inset: 0.875rem;
    border: 1px solid rgb(255 255 255 / 40%);
    content: "";
    pointer-events: none;
  }

  .hero__portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: grayscale(100%);
    transition: filter 400ms ease, transform 600ms ease;
  }

  .hero__portrait-frame:hover .hero__portrait {
    filter: grayscale(0);
    transform: scale(1.03);
  }

  .hero__portrait-caption {
    position: absolute;
    z-index: 3;
    right: 1.4375rem;
    bottom: 1.375rem;
    left: 1.4375rem;
    display: flex;
    justify-content: space-between;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
  }

  .hero__note {
    position: absolute;
    z-index: 3;
    top: 7.375rem;
    left: 0;
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 1rem 1.125rem;
    background: #d8e1d5;
    color: #202421;
    font-size: 0.6875rem;
    line-height: 1.45;
  }

  .hero__note > span:first-child {
    margin-top: 0.125rem;
    color: var(--color-accent);
  }

  .hero__note strong {
    color: #374237;
    font-weight: 800;
  }

  .hero__orbit {
    position: absolute;
    z-index: 1;
    top: 4.125rem;
    right: -2.6875rem;
    width: 20.625rem;
    height: 20.625rem;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero__orbit--secondary {
    top: 0;
    right: -6.125rem;
    width: 28.75rem;
    height: 28.75rem;
    border-color: #b8c7b6;
  }

  .hero-availability {
    background: var(--color-surface);
    color: #687069;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-availability__inner {
    display: flex;
    align-items: center;
    gap: 0.6875rem;
    padding-block: 1.0625rem;
  }

  .hero-availability__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6875rem;
    flex: 0 0 auto;
  }

  .hero-availability__dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: #6d9b68;
    box-shadow: 0 0 0 4px rgb(109 155 104 / 14%);
  }

  .hero-availability__rule {
    height: 1px;
    flex: 1;
    margin-left: 0.6875rem;
    background: #cdd4ca;
  }

  .hero-availability__location {
    flex: 0 0 auto;
    color: #9ca69c;
  }

  @media (max-width: 50rem) {
    .hero {
      padding-top: 3.5625rem;
    }

    .hero__grid {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 2.5rem;
      min-height: auto;
      padding-bottom: 3.75rem;
    }

    .hero__content {
      width: 100%;
    }

    .hero__title {
      font-size: clamp(3.125rem, 10vw, 5.3125rem);
    }

    .hero__visual {
      width: 100%;
      min-height: 26.875rem;
    }

    .hero__portrait-frame {
      right: 7%;
      width: 76%;
      height: 26.25rem;
    }

    .hero__note {
      top: 4.75rem;
      left: 0;
    }

    .hero__orbit {
      right: -8.125rem;
    }

    .hero__orbit--secondary {
      right: -11.4375rem;
    }
  }

  @media (max-width: 28.125rem) {
    .hero__title {
      font-size: 3.0625rem;
    }

    .hero__actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.25rem;
    }

    .hero__visual {
      min-height: 22.5rem;
    }

    .hero__portrait-frame {
      height: 21.875rem;
    }

    .hero__note {
      font-size: 0.625rem;
    }

    .hero-availability__location {
      display: none;
    }
  }
</style>

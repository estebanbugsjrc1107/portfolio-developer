---
import { contact } from "../../data/site";
import { getLocale, translations } from "../../i18n/translations";

const copy = translations[getLocale(Astro.currentLocale)].contact;
const emailHref = `mailto:${contact.email}?subject=${encodeURIComponent(copy.subject)}`;
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__topline">
      <p class="contact__eyebrow">
        <span>04</span>
        <span aria-hidden="true">—</span>
        <span>{copy.eyebrow}</span>
      </p>
      <span class="contact__decoration" aria-hidden="true">✳</span>
    </div>

    <h2 class="contact__title" id="contact-title">{copy.title}</h2>
    <p class="contact__description">
      {copy.description}
    </p>

    <a class="contact__button" href={emailHref}>
      {copy.button}
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
        <path d="M3 5.5 10 10l7-4.5M4.25 4h11.5C16.44 4 17 4.56 17 5.25v9.5c0 .69-.56 1.25-1.25 1.25H4.25C3.56 16 3 15.44 3 14.75v-9.5C3 4.56 3.56 4 4.25 4Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(5rem, 8vw, 6.625rem);
    background: #202421;
    color: #f4f4ef;
  }

  .contact__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .contact__eyebrow {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    color: #8e998f;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact__eyebrow span:nth-child(2) {
    color: var(--color-accent);
  }

  .contact__decoration {
    color: var(--color-accent);
    font-size: 1.75rem;
    line-height: 1;
  }

  .contact__title {
    max-width: 13ch;
    margin: clamp(3.5rem, 6vw, 4.5rem) 0 0;
    font-size: clamp(3rem, 6.2vw, 4.9375rem);
    font-weight: 500;
    letter-spacing: -0.08em;
    line-height: 1;
  }

  .contact__description {
    max-width: 32rem;
    margin-top: 1.5rem;
    color: #aab2aa;
    font-size: 0.875rem;
    line-height: 1.75;
  }

  .contact__button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
    padding: 0.75rem 1.125rem;
    background: #343b35;
    color: #f4f4ef;
    font-size: 0.6875rem;
    font-weight: 800;
    text-decoration: none;
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .contact__button svg {
    width: 1.0625rem;
    height: 1.0625rem;
  }

  .contact__button:hover {
    transform: translateY(-2px);
    background: var(--color-accent-button);
  }

  .contact__button:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__button {
      transition: none;
    }
  }
</style>

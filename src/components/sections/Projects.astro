---
import { getLocale, localizedProjects, translations } from "../../i18n/translations";

const locale = getLocale(Astro.currentLocale);
const commonCopy = translations[locale];
const copy = translations[locale].projects;
const projects = localizedProjects[locale];
const filters = [
  { value: "all", label: copy.filters[0] },
  { value: "product", label: copy.filters[1] },
  { value: "experiment", label: copy.filters[2] },
] as const;
---

<section class="projects section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="projects__heading">
      <div>
        <p class="projects__eyebrow">02 <span aria-hidden="true">—</span> {copy.eyebrow}</p>
        <h2 class="projects__title" id="projects-title">{copy.title}</h2>
      </div>
      <p class="projects__intro">
        {copy.intro}
      </p>
    </div>

    <div class="projects__filters" role="group" aria-label={copy.filterLabel}>
      {filters.map((filter, index) => (
        <button
          class="projects__filter"
          type="button"
          data-project-filter={filter.value}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {filter.label}
        </button>
      ))}
    </div>

    <div class="projects__grid" id="project-list">
      {projects.map((project) => (
        <article
          class="project-card"
          data-project-card
          data-project-type={project.type}
          aria-labelledby={`project-${project.number}-title`}
        >
          <div class={`project-card__visual project-card__visual--${project.palette}`} aria-hidden="true">
            <span class="project-card__number">{project.number}</span>
            <span class="project-card__label">{project.label}</span>
            <span class="project-card__shape project-card__shape--one"></span>
            <span class="project-card__shape project-card__shape--two"></span>
            <span class="project-card__shape project-card__shape--three"></span>
          </div>

          <div class="project-card__content">
            <div class="project-card__copy">
              <span class="visually-hidden">{project.label}</span>
              <div class="project-card__heading">
                <h3 id={`project-${project.number}-title`}>{project.title}</h3>
                <span class="project-card__type">{project.type === "product" ? copy.product : copy.experiment}</span>
              </div>
              <p class="project-card__description">{project.description}</p>
              <ul class="project-card__technologies" aria-label={`${copy.technologyLabel} ${project.title}`}>
                {project.technologies.map((technology) => <li>{technology}</li>)}
              </ul>
            </div>
            {project.href ? (
              <a
                class="project-card__action"
                href={project.href}
                target="_blank"
                rel="noreferrer"
                aria-label={`${copy.viewLabel} ${project.title} (${commonCopy.opensNewTab})`}
              >
                <svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
                  <path d="M5.5 14.5 14.5 5.5M6 5.5h8.5V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ) : (
              <span class="project-card__action project-card__action--pending" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none">
                  <path d="M5.5 14.5 14.5 5.5M6 5.5h8.5V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-project-filter]");
  const projectCards = document.querySelectorAll<HTMLElement>("[data-project-card]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedFilter = button.dataset.projectFilter ?? "all";

      filterButtons.forEach((filterButton) => {
        filterButton.setAttribute("aria-pressed", String(filterButton === button));
      });

      projectCards.forEach((card) => {
        const matchesFilter = selectedFilter === "all" || card.dataset.projectType === selectedFilter;
        card.hidden = !matchesFilter;
      });
    });
  });
</script>

<style>
  .projects {
    padding-block: clamp(5rem, 8vw, 6.875rem);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .projects__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .projects__eyebrow {
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .projects__eyebrow span {
    color: var(--color-accent);
  }

  .projects__title {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.5rem, 4.2vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 1.04;
  }

  .projects__intro {
    max-width: 16rem;
    padding-bottom: 0.4rem;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .projects__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-block: 3.75rem 1.875rem;
  }

  .projects__filter {
    min-height: 2.75rem;
    padding: 0 0.125rem;
    border: 0;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .projects__filter:hover,
  .projects__filter[aria-pressed="true"] {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .projects__filter:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 1.25rem;
  }

  .project-card {
    min-width: 0;
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card__visual {
    position: relative;
    display: flex;
    height: clamp(13rem, 20vw, 16.875rem);
    align-items: flex-start;
    justify-content: space-between;
    overflow: hidden;
    padding: 1.125rem;
    isolation: isolate;
  }

  .project-card__visual--peach {
    background: #e9c9b9;
  }

  .project-card__visual--sage {
    background: #bdccbb;
  }

  .project-card__visual--blue {
    background: #bfcbd0;
  }

  .project-card__visual--ink {
    background: #333d38;
  }

  .project-card__number,
  .project-card__label {
    position: relative;
    z-index: 1;
    color: rgb(32 36 33 / 68%);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-card__visual--ink .project-card__number,
  .project-card__visual--ink .project-card__label {
    color: rgb(244 244 239 / 72%);
  }

  .project-card__shape {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    display: block;
    width: 1.7rem;
    height: 6rem;
    transform: translate(-50%, -50%) rotate(-28deg);
    background: var(--color-bg);
    opacity: 0.92;
  }

  .project-card__shape--one {
    margin-left: -2.5rem;
    height: 5.875rem;
  }

  .project-card__shape--two {
    height: 7.875rem;
    background: var(--color-accent);
  }

  .project-card__shape--three {
    margin-left: 2.5rem;
    height: 4.375rem;
  }

  .project-card__content {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.125rem;
  }

  .project-card__copy {
    min-width: 0;
  }

  .project-card__action {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-text);
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .project-card__action svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  a.project-card__action:hover {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-bg);
  }

  a.project-card__action:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .project-card__action--pending {
    color: var(--color-muted);
    opacity: 0.8;
  }

  .project-card__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project-card__heading h3 {
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.35;
  }

  .project-card__type {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    text-transform: uppercase;
  }

  .project-card__description {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.65;
  }

  .project-card__technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.875rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-card__technologies li {
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
  }

  @media (max-width: 56.25rem) {
    .projects__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1rem;
    }

    .project-card__heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.3rem;
    }
  }

  @media (max-width: 40rem) {
    .projects__heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.25rem;
    }

    .projects__intro {
      max-width: 28rem;
    }

    .projects__filters {
      gap: 1.125rem;
      margin-block: 2.5rem 1.5rem;
    }

    .projects__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .project-card__visual {
      height: 17rem;
    }

    .project-card__heading {
      align-items: baseline;
      flex-direction: row;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects__filter {
      transition: none;
    }

    .project-card__action {
      transition: none;
    }
  }
</style>
